# /etc/cron.d/negotiatex-backup -- taegliches Backup + anschliessender Wiederherstellungstest.
# Ergebnis je Lauf eine Zeile in /var/log/negotiatex-backup.log ("backup ok", "restore-test ok|FEHLER").
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
15 3 * * * root /root/negotiatex/ops/backup.sh >> /var/log/negotiatex-backup.log 2>&1 && /root/negotiatex/ops/restore_test.sh >> /var/log/negotiatex-backup.log 2>&1
