# /etc/cron.d/negotiatex-daily-check -- taeglicher Betriebsbericht per E-Mail an Rafael (nur lesend).
# 06:30 UTC = 07:30 MEZ (nach Backup 03:15). Manuell ohne Versand: bash /root/negotiatex/ops/daily_check.sh --print
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
30 6 * * * root /bin/bash /root/negotiatex/ops/daily_check.sh >> /var/log/negotiatex-daily-check.log 2>&1
